// Operação (Fase 11B, ADR-0020): instalação do sistema depois da homologação, com materiais, equipes e ordens de
// serviço. O projeto (`Project`) continua sendo o fio do lead ao O&M; a `Installation` é a execução dele em campo.

enum InstallationStatus {
  AWAITING_ENGINEERING
  AWAITING_MATERIAL
  MATERIAL_READY
  SCHEDULING
  CREW_ASSIGNED
  IN_PROGRESS
  FIELD_ISSUE
  INSTALLED
  COMMISSIONING
  CUSTOMER_ACCEPTANCE
  DONE
  CANCELLED

  @@map("installation_status")
}

enum MaterialItemStatus {
  PENDING
  ORDERED
  RECEIVED
  SEPARATED
  CANCELLED

  @@map("material_item_status")
}

enum WorkOrderType {
  VISIT
  SURVEY
  INSTALLATION
  COMMISSIONING
  MAINTENANCE
  CLEANING

  @@map("work_order_type")
}

enum WorkOrderStatus {
  /// Criada, ainda sem data.
  PENDING
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("work_order_status")
}

enum CommissioningStatus {
  IN_PROGRESS
  /// Enviado ao responsável técnico para revisão e aprovação.
  SUBMITTED
  APPROVED
  REJECTED

  @@map("commissioning_status")
}

enum CommissioningResult {
  PENDING
  PENDING_RULE
  PENDING_DATA
  PASS
  FAIL
  NOT_APPLICABLE

  @@map("commissioning_result")
}

enum FieldIssueStatus {
  OPEN
  RESOLVED

  @@map("field_issue_status")
}

/// Execução em campo de um projeto homologado (1:1 com o `Project`).
model Installation {
  id                            String             @id @default(uuid(7)) @db.Uuid
  tenantId                      String             @map("tenant_id") @db.Uuid
  projectId                     String             @unique @map("project_id") @db.Uuid
  opportunityId                 String             @map("opportunity_id") @db.Uuid
  projectCode                   String             @map("project_code")
  accountId                     String             @map("account_id") @db.Uuid
  siteId                        String?            @map("site_id") @db.Uuid
  /// Snapshot técnico aprovado de onde vieram os materiais (da cotação do contrato). Nulo = sem projeto técnico.
  engineeringSnapshotId         String?            @map("engineering_snapshot_id") @db.Uuid
  status                        InstallationStatus @default(AWAITING_ENGINEERING)
  responsibleId                 String?            @map("responsible_id") @db.Uuid
  materialsGeneratedAt          DateTime?          @map("materials_generated_at")
  materialsReadyAt              DateTime?          @map("materials_ready_at")
  installedAt                   DateTime?          @map("installed_at")
  doneAt                        DateTime?          @map("done_at")
  cancelledAt                   DateTime?          @map("cancelled_at")
  cancelReason                  String?            @map("cancel_reason")
  /// Aceite do cliente (registro, não assinatura eletrônica): quem, quando, por qual canal e de onde.
  acceptedAt                    DateTime?          @map("accepted_at")
  acceptedByName                String?            @map("accepted_by_name")
  /// `FIELD` (assinatura em campo), `OFFICE` (registrado pelo escritório) ou `PORTAL` (cliente, pelo link).
  acceptedChannel               String?            @map("accepted_channel")
  acceptanceNote                String?            @map("acceptance_note")
  acceptanceIp                  String?            @map("acceptance_ip")
  acceptanceUserAgent           String?            @map("acceptance_user_agent")
  acceptanceSignatureDocumentId String?            @map("acceptance_signature_document_id") @db.Uuid
  createdAt                     DateTime           @default(now()) @map("created_at")
  updatedAt                     DateTime           @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  project       Project               @relation(fields: [projectId], references: [id])
  commissioning CommissioningRecord[]
  materials     MaterialItem[]
  workOrders    WorkOrder[]
  issues        FieldIssue[]
  history       InstallationHistory[]

  @@index([tenantId, status])
  @@index([tenantId, accountId])
  @@map("installations")
}

/// Histórico imutável das mudanças de situação da instalação.
model InstallationHistory {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  installationId String              @map("installation_id") @db.Uuid
  fromStatus     InstallationStatus? @map("from_status")
  toStatus       InstallationStatus  @map("to_status")
  reason         String?
  actorId        String?             @map("actor_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([tenantId, installationId, createdAt])
  @@map("installation_history")
}

/// Linha da lista de materiais da instalação (gerada do snapshot técnico aprovado, ou lançada à mão).
model MaterialItem {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  installationId String             @map("installation_id") @db.Uuid
  category       String
  equipmentId    String?            @map("equipment_id") @db.Uuid
  description    String
  quantity       Float
  unit           String
  /// Custo unitário previsto (da lista de materiais do snapshot), em centavos.
  unitCostCents  Int?               @map("unit_cost_cents")
  status         MaterialItemStatus @default(PENDING)
  supplier       String?
  purchaseOrder  String?            @map("purchase_order")
  /// Valor realmente pago no pedido, em centavos (alimenta o realizado do financeiro do projeto).
  orderedCents   Int?               @map("ordered_cents")
  expectedAt     DateTime?          @map("expected_at")
  receivedAt     DateTime?          @map("received_at")
  separatedAt    DateTime?          @map("separated_at")
  note           String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([tenantId, installationId, status])
  @@map("material_items")
}

model Crew {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  members    CrewMember[]
  workOrders WorkOrder[]

  @@unique([tenantId, name])
  @@map("crews")
}

model CrewMember {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  crewId   String @map("crew_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([crewId, userId])
  @@index([tenantId, userId])
  @@map("crew_members")
}

/// Visita, instalação, ensaio, manutenção ou limpeza. Nasce da instalação (ou, nas fases seguintes, da planta).
model WorkOrder {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  installationId      String?         @map("installation_id") @db.Uuid
  projectCode         String?         @map("project_code")
  accountId           String?         @map("account_id") @db.Uuid
  siteId              String?         @map("site_id") @db.Uuid
  type                WorkOrderType
  status              WorkOrderStatus @default(PENDING)
  title               String
  notes               String?
  crewId              String?         @map("crew_id") @db.Uuid
  /// Técnico responsável pela execução (além da equipe).
  assigneeId          String?         @map("assignee_id") @db.Uuid
  scheduledStart      DateTime?       @map("scheduled_start")
  scheduledEnd        DateTime?       @map("scheduled_end")
  startedAt           DateTime?       @map("started_at")
  completedAt         DateTime?       @map("completed_at")
  cancelReason        String?         @map("cancel_reason")
  /// Itens a conferir em campo: `[{ id, label, done, note, doneAt, doneById }]`. Definidos por quem cria a ordem.
  checklist           Json            @default("[]")
  /// Pontos de geolocalização registrados pelo app de campo: `[{ kind, latitude, longitude, accuracy, at, userId }]`.
  geo                 Json            @default("[]")
  /// Ordens de pós-venda: a planta, o chamado e o plano de manutenção de onde nasceram.
  plantId             String?         @map("plant_id") @db.Uuid
  ticketId            String?         @map("ticket_id") @db.Uuid
  maintenancePlanId   String?         @map("maintenance_plan_id") @db.Uuid
  /// Assinatura do cliente (imagem) e quem assinou.
  signatureDocumentId String?         @map("signature_document_id") @db.Uuid
  signedByName        String?         @map("signed_by_name")
  signedAt            DateTime?       @map("signed_at")
  createdById         String?         @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  installation Installation?    @relation(fields: [installationId], references: [id])
  crew         Crew?            @relation(fields: [crewId], references: [id])
  issues       FieldIssue[]
  photos       WorkOrderPhoto[]

  @@index([tenantId, status, scheduledStart])
  @@index([tenantId, installationId])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, crewId, scheduledStart])
  @@index([tenantId, plantId])
  @@map("work_orders")
}

/// Pendência de campo (impedimento, falta de material, acesso, segurança). Uma pendência que bloqueia pára a instalação.
model FieldIssue {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  installationId String           @map("installation_id") @db.Uuid
  workOrderId    String?          @map("work_order_id") @db.Uuid
  type           String
  description    String
  blocking       Boolean          @default(true)
  status         FieldIssueStatus @default(OPEN)
  resolution     String?
  reportedById   String?          @map("reported_by_id") @db.Uuid
  resolvedById   String?          @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id])

  @@index([tenantId, installationId, status])
  @@map("field_issues")
}

/// Foto de campo de uma ordem de serviço. O arquivo fica em `Document`; aqui ficam a legenda, o momento, o local e se o
/// cliente pode vê-la no portal. `clientActionId` torna o envio idempotente (reenviar a mesma foto não duplica).
model WorkOrderPhoto {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  workOrderId       String   @map("work_order_id") @db.Uuid
  documentId        String   @unique @map("document_id") @db.Uuid
  clientActionId    String   @map("client_action_id")
  caption           String?
  takenAt           DateTime @map("taken_at")
  latitude          Float?
  longitude         Float?
  accuracy          Float?
  visibleToCustomer Boolean  @default(false) @map("visible_to_customer")
  uploadedById      String?  @map("uploaded_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientActionId])
  @@index([tenantId, workOrderId])
  @@map("work_order_photos")
}

/// Ação enviada pelo app de campo (que pode ter ficado horas offline). A chave do cliente torna a sincronização
/// idempotente: reenviar um lote não repete nada. Guarda o resultado para devolver o mesmo na repetição.
model FieldAction {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  clientActionId String   @map("client_action_id")
  userId         String   @map("user_id") @db.Uuid
  workOrderId    String?  @map("work_order_id") @db.Uuid
  type           String
  capturedAt     DateTime @map("captured_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  /// `APPLIED` ou `REJECTED`.
  status         String
  message        String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, clientActionId])
  @@index([tenantId, workOrderId])
  @@map("field_actions")
}

/// Comissionamento de uma instalação (uma tentativa). O modelo de ensaios e as tolerâncias vêm da regra
/// `ops.commissioning` ativa e revisada; sem ela vale o modelo-base provisório e a aprovação fica travada.
model CommissioningRecord {
  id                    String              @id @default(uuid(7)) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  installationId        String              @map("installation_id") @db.Uuid
  /// Reprovado volta a instalar e a próxima tentativa abre um registro novo.
  attempt               Int
  status                CommissioningStatus @default(IN_PROGRESS)
  /// `STANDARD` (categoria 1) ou `EXTENDED` (categoria 1 + 2).
  level                 String              @default("STANDARD")
  /// Regra usada (`<id>@<versão>` ou o modelo-base) e se é provisória.
  ruleRef               String              @map("rule_ref")
  provisional           Boolean
  ruleNote              String?             @map("rule_note")
  ruleSources           Json                @default("[]") @map("rule_sources")
  ruleReviewedBy        String?             @map("rule_reviewed_by")
  internalTestRule      Boolean             @default(false) @map("internal_test_rule")
  engineeringSnapshotId String?             @map("engineering_snapshot_id") @db.Uuid
  /// Condições medidas no local: `{ irradianceWm2, moduleTempC, ambientC }`.
  conditions            Json                @default("{}")
  /// Modelo de ensaios usado, congelado (a regra pode mudar depois; este registro continua com o que valeu nele).
  model                 Json                @default("{}")
  /// Ensaios do modelo que não geraram linha e avisos de dado faltando.
  skipped               Json                @default("[]")
  notes                 Json                @default("[]")
  startedAt             DateTime            @default(now()) @map("started_at")
  submittedAt           DateTime?           @map("submitted_at")
  submittedById         String?             @map("submitted_by_id") @db.Uuid
  decidedAt             DateTime?           @map("decided_at")
  decidedById           String?             @map("decided_by_id") @db.Uuid
  decisionNote          String?             @map("decision_note")
  reportDocumentId      String?             @map("report_document_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  installation Installation        @relation(fields: [installationId], references: [id])
  tests        CommissioningTest[]

  @@unique([installationId, attempt])
  @@index([tenantId, status])
  @@map("commissioning_records")
}

model CommissioningTest {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  recordId         String              @map("record_id") @db.Uuid
  position         Int
  code             String
  label            String
  testGroup        String              @map("test_group")
  kind             String
  level            String
  scope            String
  unit             String?
  /// `NONE`, `VOC_STRING` ou `ISC_STRING`.
  expectedKind     String              @map("expected_kind")
  tolerancePct     Float?              @map("tolerance_pct")
  minValue         Float?              @map("min_value")
  maxValue         Float?              @map("max_value")
  required         Boolean
  source           String
  subjectKey       String              @map("subject_key")
  subjectLabel     String              @map("subject_label")
  /// Dados elétricos da string (para calcular o esperado): `{ modulesInSeries, vocStcV, ... }`.
  electrical       Json?
  result           CommissioningResult @default(PENDING)
  measuredValue    Float?              @map("measured_value")
  passed           Boolean?
  expectedValue    Float?              @map("expected_value")
  deviationPct     Float?              @map("deviation_pct")
  basis            String?
  reason           String?
  note             String?
  /// Condições desta medição, quando diferem das do registro (a irradiância muda ao longo do dia).
  conditions       Json?
  measuredAt       DateTime?           @map("measured_at")
  measuredById     String?             @map("measured_by_id") @db.Uuid
  /// Fotos de campo (`WorkOrderPhoto`) que servem de evidência deste ensaio.
  evidencePhotoIds Json                @default("[]") @map("evidence_photo_ids")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  record CommissioningRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, code, subjectKey])
  @@index([tenantId, recordId, position])
  @@map("commissioning_tests")
}

// Monitoramento de inversores (Fase 11F): dados de geração, potência e alarmes.
// Integrados via `IntegrationConnection` (provisor Growatt, SolarEdge, etc).

model PlantMonitoringLink {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  connectionId     String              @map("connection_id") @db.Uuid
  externalPlantId  String              @map("external_plant_id")
  addedAt          DateTime            @default(now()) @map("added_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  plant      Plant                   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  connection IntegrationConnection   @relation(fields: [connectionId], references: [id])

  @@unique([plantId, connectionId])
  @@index([tenantId, plantId])
  @@index([tenantId, connectionId])
  @@map("plant_monitoring_links")
}

model MonitoringDaily {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  plantId      String    @map("plant_id") @db.Uuid
  date         DateTime  @db.Date
  kwhGenerated Decimal   @map("kwh_generated") @db.Decimal(10, 2)
  source       String
  receivedAt   DateTime  @default(now()) @map("received_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plant  Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, date, source])
  @@index([tenantId, plantId, date])
  @@map("monitoring_daily")
}

model MonitoringSnapshot {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  plantId   String    @map("plant_id") @db.Uuid
  kwhPower  Decimal   @map("kwh_power") @db.Decimal(10, 2)
  status    String
  receivedAt DateTime @default(now()) @map("received_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plant  Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId])
  @@index([tenantId, plantId])
  @@map("monitoring_snapshots")
}

model MonitoringAlarm {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  plantId     String     @map("plant_id") @db.Uuid
  code        String
  text        String
  severity    String
  openedAt    DateTime   @map("opened_at")
  closedAt    DateTime?  @map("closed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plant  Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([tenantId, plantId, openedAt])
  @@index([tenantId, closedAt])
  @@map("monitoring_alarms")
}
