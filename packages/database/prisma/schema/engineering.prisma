// Solar Engine Studio (Fase 9D, ADR-0015): projeto técnico com versões. O desenho é um documento JSON validado por
// schema; os resultados são recalculados. Versão enviada ou decidida é congelada (gatilho). O snapshot da versão aprovada
// é imutável e é o que o CRM consome.

enum EngineeringProjectStatus {
  IN_PROGRESS
  APPROVED
  CANCELLED

  @@map("engineering_project_status")
}

enum EngineeringVersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("engineering_version_status")
}

enum ReviewCommentStatus {
  OPEN
  RESOLVED

  @@map("review_comment_status")
}

model EngineeringProject {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  /// Project ID global da oportunidade, quando houver; senão `ENG-AAAA-NNNN` gerado pela empresa.
  code                String
  name                String
  status              EngineeringProjectStatus @default(IN_PROGRESS)
  opportunityId       String?                  @map("opportunity_id") @db.Uuid
  responsibleId       String?                  @map("responsible_id") @db.Uuid
  /// Ficha do projeto (9K): onde, para qual UC/distribuidora, que potência e quem assina.
  siteId              String?                  @map("site_id") @db.Uuid
  consumerUnitId      String?                  @map("consumer_unit_id") @db.Uuid
  distributorId       String?                  @map("distributor_id") @db.Uuid
  /// Potência-alvo (kWp) e a classe de geração derivada dela (`MICRO`, `MINI`, `PLANT`).
  targetKwp           Float?                   @map("target_kwp")
  generationClass     String?                  @map("generation_class")
  /// Responsável técnico: `ART`, `TRT` ou `RRT`, número e registro no conselho (CREA/CFT/CAU).
  artType             String?                  @map("art_type")
  artNumber           String?                  @map("art_number")
  councilRegistration String?                  @map("council_registration")
  /// Profissional que assina o projeto (cada projeto tem o seu): nome, conselho (`CREA`, `CFT`, `CAU`), UF do registro e data da ART/TRT/RRT.
  signatoryName       String?                  @map("signatory_name")
  councilType         String?                  @map("council_type")
  councilState        String?                  @map("council_state")
  artIssuedAt         DateTime?                @map("art_issued_at") @db.Date
  notes               String?
  createdById         String?                  @map("created_by_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  opportunity   Opportunity?              @relation(fields: [opportunityId], references: [id])
  versions      EngineeringVersion[]
  snapshots     EngineeringSnapshot[]
  requests      EngineeringRequest[]
  events        EngineeringEvent[]
  survey        EngineeringSurvey?
  documentItems EngineeringDocumentItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, opportunityId])
  @@map("engineering_projects")
}

model EngineeringVersion {
  id            String                   @id @default(uuid(7)) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  projectId     String                   @map("project_id") @db.Uuid
  number        Int
  status        EngineeringVersionStatus @default(DRAFT)
  /// Documento do desenho (`engineeringDesignSchema`).
  design        Json
  /// Resultados recalculados a partir do desenho (nulo até o primeiro cálculo).
  results       Json?
  /// Hash do desenho: detecta mudança de premissa e identifica o que foi aprovado.
  fingerprint   String?
  /// Marcada quando regra, catálogo ou premissa mudaram depois do cálculo.
  stale         Boolean                  @default(false)
  staleReasons  Json                     @default("[]") @map("stale_reasons")
  /// `<id>@<versão>` das regras usadas no cálculo.
  ruleRefs      Json                     @default("[]") @map("rule_refs")
  dataRefs      Json                     @default("[]") @map("data_refs")
  submittedAt   DateTime?                @map("submitted_at")
  submittedById String?                  @map("submitted_by_id") @db.Uuid
  decidedAt     DateTime?                @map("decided_at")
  decidedById   String?                  @map("decided_by_id") @db.Uuid
  decisionNote  String?                  @map("decision_note")
  createdById   String?                  @map("created_by_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  tenant    Tenant                        @relation(fields: [tenantId], references: [id])
  project   EngineeringProject            @relation(fields: [projectId], references: [id])
  equipment EngineeringVersionEquipment[]
  comments  EngineeringReviewComment[]
  snapshot  EngineeringSnapshot?

  @@unique([projectId, number])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
  @@map("engineering_versions")
}

/// Equipamentos do catálogo usados numa versão (consulta de impacto: "quais projetos usam este módulo?").
model EngineeringVersionEquipment {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  versionId   String @map("version_id") @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  kind        String
  quantity    Int    @default(1)

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  version EngineeringVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, equipmentId])
  @@index([tenantId, equipmentId])
  @@map("engineering_version_equipment")
}

/// Comentário do responsável técnico em uma seção da versão. Comentário aberto bloqueia a aprovação.
model EngineeringReviewComment {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  versionId    String              @map("version_id") @db.Uuid
  /// Seção do projeto (`site`, `surfaces`, `strings`...).
  section      String
  authorId     String?             @map("author_id") @db.Uuid
  text         String
  status       ReviewCommentStatus @default(OPEN)
  resolvedById String?             @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?           @map("resolved_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  version EngineeringVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([tenantId, versionId, status])
  @@map("engineering_review_comments")
}

/// Fotografia imutável da versão aprovada: desenho, resultados, fichas copiadas, regras e fontes, dados externos com
/// proveniência. É o que o CRM consome (Project Guard, cotação).
model EngineeringSnapshot {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  versionId    String   @unique @map("version_id") @db.Uuid
  content      Json
  hash         String
  approvedById String?  @map("approved_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant  Tenant                 @relation(fields: [tenantId], references: [id])
  project EngineeringProject     @relation(fields: [projectId], references: [id])
  version EngineeringVersion     @relation(fields: [versionId], references: [id])
  quotes  Quote[]
  shares  EngineeringShareLink[]

  @@index([tenantId, projectId])
  @@map("engineering_snapshots")
}

/// Link público do relatório técnico simplificado para o cliente final. Só o hash do token é guardado (o link aparece uma vez).
model EngineeringShareLink {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  snapshotId   String    @map("snapshot_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  snapshot EngineeringSnapshot @relation(fields: [snapshotId], references: [id])

  @@index([tenantId, snapshotId])
  @@map("engineering_share_links")
}

/// Linha do tempo do pedido e do projeto: comentários, mudanças de estado, pedidos de informação, visitas.
model EngineeringEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  requestId String?  @map("request_id") @db.Uuid
  /// `COMMENT`, `STATUS`, `ASSIGNED`, `INFO_REQUEST`, `INFO_ANSWER`, `PRIORITY`, `SURVEY`, `DOCUMENT`, `PROJECT`.
  type      String
  text      String?
  data      Json     @default("{}")
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  project EngineeringProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  request EngineeringRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, createdAt])
  @@index([tenantId, requestId, createdAt])
  @@map("engineering_events")
}

/// Levantamento do local (visita técnica): um por projeto. O conteúdo é validado por `surveySchema` (shared).
model EngineeringSurvey {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  projectId     String    @unique @map("project_id") @db.Uuid
  /// `DRAFT` ou `COMPLETED`.
  status        String    @default("DRAFT")
  data          Json      @default("{}")
  completedAt   DateTime? @map("completed_at")
  completedById String?   @map("completed_by_id") @db.Uuid
  updatedById   String?   @map("updated_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  project EngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("engineering_surveys")
}

/// Pacote de documentos da solicitação de acesso (EF-R04), por projeto: o que já está pronto e o que falta.
model EngineeringDocumentItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  code        String
  title       String
  description String?
  required    Boolean
  position    Int
  /// `PENDING`, `READY` ou `NOT_APPLICABLE`.
  status      String   @default("PENDING")
  documentId  String?  @map("document_id") @db.Uuid
  note        String?
  source      String
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  project EngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@map("engineering_document_items")
}
