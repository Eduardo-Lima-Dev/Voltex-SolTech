{
  "name": "@voltex/solar-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Cálculos puros e determinísticos de dimensionamento fotovoltaico, compartilhados entre API e Web",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "@voltex/eslint-config": "workspace:^",
    "@voltex/tsconfig": "workspace:^",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@voltex/shared": "workspace:^",
    "zod": "^4.6.7"
  }
}
