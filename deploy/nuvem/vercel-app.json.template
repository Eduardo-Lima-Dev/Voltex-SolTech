{
  "$comment": "Aplicação (SPA) na Vercel. /api é encaminhado para a API na Render: o navegador só fala com este endereço, então o cookie de login continua do mesmo site. __API_HOST__ é trocado por scripts/publicar-front.sh.",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://__API_HOST__/api/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
