# Variáveis do SERVIDOR DE TESTE. O comando `./scripts/servidor-teste.sh preparar` copia este arquivo para `.env.servidor`
# na raiz do projeto e já preenche os segredos com valores aleatórios. Só falta ajustar os endereços (WEB_URL, SITE_URL).
# O `.env.servidor` NUNCA vai para o Git. Guia: docs/08-deploy/servidor-de-teste.md

# --- Endereços públicos (sem barra no final) ---
# A aplicação (login, CRM). Entra nos links de convite e de proposta e é o destino do botão "Entrar" do site.
WEB_URL=https://app.suaempresa.com.br
# O site de apresentação (opcional): vira o "Voltar ao site" da tela de entrada.
SITE_URL=https://www.suaempresa.com.br

# --- Segredos (preenchidos pelo comando `preparar`; não use valores simples) ---
POSTGRES_USER=voltex
POSTGRES_PASSWORD=
POSTGRES_DB=voltex
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=voltex-documents
JWT_SECRET=
JWT_REFRESH_SECRET=
# Chave que cifra CPF/CNPJ e textos de contrato. GUARDE UMA CÓPIA FORA DO NOTEBOOK: sem ela esses dados não abrem.
DATA_ENCRYPTION_KEY=

# --- Formulário de contato do site ---
# Chave de captação da empresa que recebe os contatos. Só existe depois de criar a empresa: veja o guia (passo 7).
SITE_LEAD_KEY=

# --- Túnel da Cloudflare (modo recomendado) ---
# Token do túnel, gerado no painel da Cloudflare. Vazio = sem túnel (acesso só pelo próprio notebook ou por SSH).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Portas (só escutam em 127.0.0.1) ---
WEB_PORT=8080
SITE_PORT=8081
MAILPIT_UI_PORT=8025

# --- Backup ---
# Pasta das cópias do banco e dos arquivos (de preferência em OUTRO disco). Os 14 dias mais recentes são mantidos.
BACKUP_DIR=/var/backups/voltex
BACKUP_KEEP_DAYS=14
