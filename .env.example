# Copie para .env (o `pnpm setup` e o `pnpm dev` fazem isso automaticamente se o arquivo não existir).
# NUNCA versione o .env. Os valores abaixo são apenas para desenvolvimento local.

NODE_ENV=development

# --- API ---
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# Base dos links enviados por e-mail (convites)
WEB_URL=http://localhost:5173

# --- PostgreSQL (container do docker/compose.dev.yml) ---
# A porta do host é 5433 para não conflitar com um PostgreSQL local na 5432.
POSTGRES_USER=voltex
POSTGRES_PASSWORD=voltex
POSTGRES_DB=voltex
POSTGRES_PORT=5433
DATABASE_URL=postgresql://voltex:voltex@localhost:5433/voltex

# --- Redis (filas BullMQ) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Armazenamento de arquivos (RustFS S3-compatível em dev, S3 em produção) ---
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voltex-documents
S3_ACCESS_KEY=voltex
S3_SECRET_KEY=voltex-secret
S3_FORCE_PATH_STYLE=true
# S3_SERVER_SIDE_ENCRYPTION=none # AES256 pede ao armazenamento que cifre os arquivos em repouso (S3 da AWS: sim; confira o seu)

# --- E-mail (Mailpit em dev: interface em http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM="Voltex SolTech <no-reply@voltex.local>"

# --- Segurança (gere valores aleatórios fora do desenvolvimento: openssl rand -base64 48) ---
# O access token é um JWT assinado com JWT_SECRET; o refresh token é opaco (aleatório, guardado só como hash).
JWT_SECRET=dev-only-change-me-jwt-secret-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Opcionais (valores padrão entre parênteses) ---
# INVITATION_TTL=7d
# UPLOAD_MAX_BYTES=15728640
# THROTTLE_LIMIT=120          # requisições por minuto por IP; o login tem limite próprio de 5/min
# DATA_ENCRYPTION_KEY=        # chave-mestra ATUAL (32 bytes em base64). OBRIGATÓRIA em produção: `openssl rand -base64 32`. Perdê-la = perder os dados cifrados
# DATA_ENCRYPTION_KEY_PREVIOUS= # chaves ANTERIORES (separadas por vírgula), só durante o rodízio: veja docs/08-deploy/seguranca-lgpd.md
# METRICS_TOKEN=             # liga /api/v1/metrics (Prometheus) com este token (16+ caracteres); vazio = desligado
# TRUST_PROXY=0               # proxies confiáveis na frente da API (o compose de produção usa 1: nginx)
# OUTBOX_POLL_INTERVAL_MS=1000 # 0 desliga o worker de eventos
# AUTOMATION_SCAN_INTERVAL_MS=60000 # varredura das automações do CRM (SLA de lead, fatura pendente); 0 desliga
# AUTOMATION_QUEUE_PREFIX=voltex # prefixo das chaves da fila no Redis
# AUTOMATION_RETENTION_INTERVAL_MS=86400000 # rotina diária da política de retenção (LGPD); 0 desliga
# REFRESH_REUSE_GRACE_MS=10000

# --- Seed (somente desenvolvimento) ---
SEED_PASSWORD=Voltex@2026

# --- Web ---
# Opcional. Padrão: o front chama `/api/v1` na própria origem (proxy do Vite em dev; nginx em produção).
# Defina só para apontar o front para uma API em outro endereço (exige CORS_ORIGIN na API).
# VITE_API_URL=http://localhost:3000/api/v1

# --- Site de apresentação (apps/site) e ligação com a aplicação ---
# Endereço público da aplicação: o botão "Entrar" do site leva a {VITE_APP_URL}/login.
# Em desenvolvimento o padrão é http://localhost:5173. Em produção, por exemplo https://app.suaempresa.com.br
# VITE_APP_URL=http://localhost:5173
# Endereço público do site: a tela de entrada da aplicação mostra "Voltar ao site". Em dev: http://localhost:5174
# VITE_SITE_URL=http://localhost:5174
# Chave de captação de leads da empresa dona da plataforma (CRM Solar → Leads → captação): recebe o formulário do site.
# VITE_LEAD_KEY=
